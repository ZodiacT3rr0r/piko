let sum = 0;
for (let i = 1; i <= 5; i = i + 1) {
    if (i % 2 == 1 and i > 0) {
        sum = sum + i;
    } else {
        sum = sum + 10;
    }
}
print(sum);

let count = 3;
let acc = 1;
while (count > 0) {
    acc = acc * 2;
    count = count - 1;
}
print(acc);

if (false or acc == 8) {
    print(42);
}

