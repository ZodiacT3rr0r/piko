PROGRAM count=4
  LET name=x
    INT_LIT value=10
  LET name=y
    FLOAT_LIT value=3.14
  PRINT_STMT
    BINARY op=TOK_PLUS
      IDENT name=x
      IDENT name=y
  PRINT_STMT
    BINARY op=TOK_PLUS
      STRING_LIT value="sum="
      CALL
        callee:
          IDENT name=str
        args=1
          BINARY op=TOK_PLUS
            IDENT name=x
            IDENT name=y
